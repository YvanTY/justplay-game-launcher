export enum Action { up, down, left, right, confirm, back, options, tab-prev, tab-next, page-prev, page-next, menu }

export enum Zone { tabs, icons, actions, recent }

export struct Tile {
    title: string,
    color: color,
    icon: image,
    has-icon: bool,
}

// A quick-panel tile: big glyph above a label (BuzzTV-style square buttons).
component PanelTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> focused;
    in property <length> u;
    border-radius: 20 * u;
    background: focused ? #2d8cff : #ffffff12;
    border-width: focused ? 0 : 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: focused ? 28 * u : 0;
    drop-shadow-color: #2d8cff80;
    animate background { duration: 120ms; }
    VerticalLayout {
        alignment: center;
        spacing: 14 * u;
        Text {
            text: glyph;
            font-family: "Segoe MDL2 Assets";
            font-size: 46 * u;
            color: white;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: 24 * u;
            color: white;
            horizontal-alignment: center;
        }
    }
}

export struct RemapRow {
    badge: string,
    label: string,
    value: string,
    column: int,
    row: int,
}

// A round or rounded key on the controller picture. Selected: blue glow; held: white.
component PadKey inherits Rectangle {
    in property <bool> lit;
    in property <bool> pressed;
    in property <string> text;
    in property <color> text-color: white;
    in property <string> font: "Segoe UI";
    background: pressed ? white : lit ? #2d8cff : @linear-gradient(180deg, #3a4357 0%, #232a38 100%);
    border-width: lit ? 2px : 1px;
    border-color: lit ? #a9d4ff : #ffffff2e;
    drop-shadow-blur: lit ? 28px : 6px;
    drop-shadow-color: lit ? #2d8cffd8 : #00000080;
    drop-shadow-offset-y: lit ? 0 : 2px;
    animate background { duration: 90ms; }
    Text {
        width: parent.width;
        height: parent.height;
        text: text;
        color: pressed ? black : lit ? white : text-color;
        font-family: font;
        font-size: parent.height * 0.44;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A thumbstick: dark well, raised cap, and an arrow on each side for its four directions.
component Thumbstick inherits Rectangle {
    in property <length> s;
    in property <string> label;
    in property <bool> click-lit;
    in property <bool> click-pressed;
    // up, left, right, down
    in property <[bool]> dir-lit;
    in property <[bool]> dir-pressed;
    width: 136 * s;
    height: 136 * s;
    Rectangle {
        border-radius: self.width / 2;
        background: #0b0f17;
        border-width: 1px;
        border-color: #ffffff1f;
    }

    PadKey {
        x: 18 * s;
        y: 18 * s;
        width: 100 * s;
        height: 100 * s;
        border-radius: self.width / 2;
        text: label;
        lit: click-lit;
        pressed: click-pressed;
    }

    for arrow[i] in [
        { x: 54, y: -14, glyph: "\u{EDDB}" },
        { x: -14, y: 54, glyph: "\u{EDD9}" },
        { x: 122, y: 54, glyph: "\u{EDDA}" },
        { x: 54, y: 122, glyph: "\u{EDDC}" },
    ]: Text {
        x: arrow.x * s;
        y: arrow.y * s;
        width: 28 * s;
        height: 28 * s;
        text: arrow.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: 16 * s;
        color: dir-pressed[i] ? white : dir-lit[i] ? #4da3ff : #ffffff33;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// An Xbox-layout controller in a 1000 x 640 design space. Button order matches
// controllers::ALL: left column 0-9, D-pad box 10-13, right column 14-24.
component ControllerPicture inherits Rectangle {
    in property <int> highlight;
    in property <[bool]> live;
    property <length> s: self.width / 1000;
    Path {
        y: 70 * s;
        width: parent.width;
        height: 570 * s;
        viewbox-width: 1000;
        viewbox-height: 570;
        commands: "M 250 10 C 330 -10 670 -10 750 10 C 840 30 905 100 935 235 C 970 390 990 495 935 545 C 885 590 800 555 740 455 C 715 415 690 395 640 395 L 360 395 C 310 395 285 415 260 455 C 200 555 115 590 65 545 C 10 495 30 390 65 235 C 95 100 160 30 250 10 Z";
        fill: @linear-gradient(180deg, #2b3243 0%, #1a1f2b 60%, #12161f 100%);
        stroke: #ffffff2b;
        stroke-width: 2px;
    }

    // Soft highlight along the top edge for depth.
    Path {
        y: 76 * s;
        width: parent.width;
        height: 120 * s;
        viewbox-width: 1000;
        viewbox-height: 120;
        commands: "M 260 14 C 340 0 660 0 740 14 C 800 26 840 60 860 110 C 720 70 280 70 140 110 C 160 60 200 26 260 14 Z";
        fill: #ffffff0c;
    }

    PadKey { x: 230 * s; y: 0; width: 150 * s; height: 34 * s; border-radius: 14 * s; text: "LT"; lit: highlight == 0; pressed: live[0]; }
    PadKey { x: 210 * s; y: 44 * s; width: 190 * s; height: 30 * s; border-radius: 12 * s; text: "LB"; lit: highlight == 1; pressed: live[1]; }
    PadKey { x: 424 * s; y: 300 * s; width: 32 * s; height: 32 * s; border-radius: 16 * s; text: ""; lit: highlight == 2; pressed: live[2]; }
    PadKey { x: 544 * s; y: 300 * s; width: 32 * s; height: 32 * s; border-radius: 16 * s; text: ""; lit: highlight == 3; pressed: live[3]; }
    PadKey { x: 470 * s; y: 198 * s; width: 60 * s; height: 60 * s; border-radius: 30 * s; text: "◉"; text-color: #ffffff99; lit: highlight == 4; pressed: live[4]; }
    Thumbstick {
        x: 232 * s;
        y: 222 * s;
        s: s;
        label: "L3";
        click-lit: highlight == 5;
        click-pressed: live[5];
        dir-lit: [highlight == 6, highlight == 7, highlight == 8, highlight == 9];
        dir-pressed: [live[6], live[7], live[8], live[9]];
    }

    // D-pad: a cross with four separately lit arms.
    Rectangle {
        x: 330 * s;
        y: 388 * s;
        width: 120 * s;
        height: 120 * s;
        Rectangle { x: 40 * s; width: 40 * s; border-radius: 6 * s; background: #0b0f17; }
        Rectangle { y: 40 * s; height: 40 * s; border-radius: 6 * s; background: #0b0f17; }
        PadKey { x: 42 * s; y: 2 * s; width: 36 * s; height: 40 * s; border-radius: 5 * s; text: "\u{EDDB}"; font: "Segoe MDL2 Assets"; lit: highlight == 10; pressed: live[10]; }
        PadKey { x: 2 * s; y: 42 * s; width: 40 * s; height: 36 * s; border-radius: 5 * s; text: "\u{EDD9}"; font: "Segoe MDL2 Assets"; lit: highlight == 11; pressed: live[11]; }
        PadKey { x: 78 * s; y: 42 * s; width: 40 * s; height: 36 * s; border-radius: 5 * s; text: "\u{EDDA}"; font: "Segoe MDL2 Assets"; lit: highlight == 12; pressed: live[12]; }
        PadKey { x: 42 * s; y: 78 * s; width: 36 * s; height: 40 * s; border-radius: 5 * s; text: "\u{EDDC}"; font: "Segoe MDL2 Assets"; lit: highlight == 13; pressed: live[13]; }
    }

    PadKey { x: 620 * s; y: 0; width: 150 * s; height: 34 * s; border-radius: 14 * s; text: "RT"; lit: highlight == 14; pressed: live[14]; }
    PadKey { x: 600 * s; y: 44 * s; width: 190 * s; height: 30 * s; border-radius: 12 * s; text: "RB"; lit: highlight == 15; pressed: live[15]; }
    PadKey { x: 690 * s; y: 200 * s; width: 60 * s; height: 60 * s; border-radius: 30 * s; text: "Y"; text-color: #ffd54a; lit: highlight == 16; pressed: live[16]; }
    PadKey { x: 630 * s; y: 260 * s; width: 60 * s; height: 60 * s; border-radius: 30 * s; text: "X"; text-color: #55a8ff; lit: highlight == 17; pressed: live[17]; }
    PadKey { x: 750 * s; y: 260 * s; width: 60 * s; height: 60 * s; border-radius: 30 * s; text: "B"; text-color: #ff6262; lit: highlight == 18; pressed: live[18]; }
    PadKey { x: 690 * s; y: 320 * s; width: 60 * s; height: 60 * s; border-radius: 30 * s; text: "A"; text-color: #67d36f; lit: highlight == 19; pressed: live[19]; }
    Thumbstick {
        x: 552 * s;
        y: 382 * s;
        s: s;
        label: "R3";
        click-lit: highlight == 20;
        click-pressed: live[20];
        dir-lit: [highlight == 21, highlight == 22, highlight == 23, highlight == 24];
        dir-pressed: [live[21], live[22], live[23], live[24]];
    }
}

component RemapRowView inherits Rectangle {
    in property <RemapRow> data;
    in property <bool> selected;
    in property <bool> pressed;
    in property <length> u;
    border-radius: 12 * u;
    background: selected ? @linear-gradient(90deg, #2d8cff40 0%, #2d8cff14 100%) : pressed ? #ffffff1f : #ffffff07;
    border-width: 1px;
    border-color: selected ? #2d8cffb0 : #ffffff0f;
    animate background { duration: 90ms; }
    // Accent bar on the selected row.
    Rectangle {
        x: 0;
        y: 10 * u;
        width: 4 * u;
        height: parent.height - 20 * u;
        border-radius: 2 * u;
        background: selected ? #2d8cff : transparent;
    }

    HorizontalLayout {
        padding-left: 16 * u;
        padding-right: 16 * u;
        spacing: 14 * u;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40 * u;
                height: 40 * u;
                border-radius: 20 * u;
                background: pressed ? white : selected ? #2d8cff : #ffffff14;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: data.badge;
                    font-size: 15 * u;
                    font-weight: 700;
                    color: pressed ? black : white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1 * u;
            Text {
                text: data.label;
                font-size: 21 * u;
                font-weight: selected ? 600 : 400;
                color: white;
                overflow: elide;
            }

            Text {
                text: data.value == "" ? "No extra trigger" : "+ " + data.value;
                font-size: 16 * u;
                color: data.value == "" ? #ffffff4d : #8cc4ff;
                overflow: elide;
            }
        }
    }
}

// The B badge with a ring that fills while B is held (hold to leave the Controllers screen).
component HoldBadge inherits Rectangle {
    in property <float> progress;
    in property <length> u;
    width: 46 * u;
    height: 46 * u;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 3 * u;
        border-color: #ffffff33;
    }

    if progress > 0.001: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: #2d8cff;
        stroke-width: 3 * u;
        commands: "M 50 3.5 A 46.5 46.5 0 " + (progress > 0.5 ? "1" : "0") + " 1 " + (50 + 46.5 * Math.sin(progress * 360deg)) + " " + (50 - 46.5 * Math.cos(progress * 360deg));
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "B";
        font-size: 18 * u;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct TabInfo {
    name: string,
    count: int,
}

// Segoe MDL2 Assets ships with Windows 10 and 11 and holds the system UI glyphs.
component Glyph inherits Text {
    font-family: "Segoe MDL2 Assets";
    color: white;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <length> u;
    width: max(self.height, txt.preferred-width + 18 * u);
    height: 32 * u;
    border-radius: self.height / 2;
    border-width: 1.5 * u;
    border-color: #ffffff59;
    txt := Text {
        width: parent.width;
        height: parent.height;
        text: label;
        color: #ffffffd9;
        font-size: 16 * u;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ButtonHint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    in property <length> u;
    spacing: 10 * u;
    VerticalLayout {
        alignment: center;
        Badge { label: key; u: u; }
    }
    Text {
        text: label;
        color: #ffffffa6;
        font-size: 20 * u;
        vertical-alignment: center;
    }
}

// Game art in a rounded tile. Wide art (PS3 icons are 320x176) is shown whole over a
// dimmed, cropped copy of itself instead of having its title cropped off.
component ArtTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> ring;
    in property <length> u;
    in property <length> title-size: 18 * u;
    property <bool> wide: tile.icon.width > tile.icon.height * 1.2;
    border-radius: 14 * u;
    background: tile.has-icon ? #0c0f16 : tile.color;
    clip: true;
    if tile.has-icon && wide: Image {
        width: parent.width;
        height: parent.height;
        source: tile.icon;
        image-fit: cover;
        opacity: 0.35;
    }
    if tile.has-icon: Image {
        width: parent.width;
        height: parent.height;
        source: tile.icon;
        image-fit: wide ? contain : cover;
    }
    if !tile.has-icon: Text {
        x: 10 * u;
        width: parent.width - 20 * u;
        height: parent.height;
        text: tile.title;
        font-size: title-size;
        font-weight: 600;
        color: white;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        border-radius: parent.border-radius;
        border-width: ring ? 4 * u : 0;
        border-color: white;
    }
}

component PillButton inherits Rectangle {
    in property <bool> focused;
    in property <length> u;
    border-radius: self.height / 2;
    background: focused ? white : #ffffff29;
    border-width: focused ? 0 : 1px;
    border-color: #ffffff33;
    drop-shadow-blur: focused ? 24 * u : 0;
    drop-shadow-color: #ffffff40;
    animate background { duration: 120ms; }
}

export component AppWindow inherits Window {
    title: "Game Launcher";
    icon: @image-url("../assets/icon-256.png");
    background: #05070b;
    default-font-family: "Segoe UI";
    preferred-width: 1600px;
    preferred-height: 900px;

    in property <[TabInfo]> tabs;
    in property <int> current-tab;
    in property <Zone> zone;
    in property <[Tile]> icons;
    in property <int> selected;
    in property <int> action-index;
    in property <[Tile]> recent;
    in property <int> recent-index;

    // Two background layers crossfade: the new art goes on the hidden one, then they swap.
    in property <image> hero-a;
    in property <image> hero-b;
    in property <bool> show-a: true;
    in property <bool> has-hero;
    in property <color> backdrop: #1b2236;

    in property <string> game-title;
    in property <string> info;
    in property <image> logo;
    in property <bool> has-logo;
    in property <bool> is-favorite;
    in property <bool> selected-running;

    in property <bool> sheet-open;
    in property <[string]> sheet-items;
    in property <int> sheet-index;

    in property <string> clock;
    in property <string> date;

    // 0 none, 1 quick panel, 2 power, 3 settings, 4 controllers
    in property <int> overlay;
    in property <int> panel-index;
    in property <int> power-index;
    in property <int> settings-index;
    in property <[string]> settings-values;

    in property <string> controllers-title;
    in property <[RemapRow]> remap-rows;
    in property <int> remap-index;
    in property <[bool]> live;
    in property <bool> capturing;
    in property <string> capture-text;
    in property <float> back-progress;
    in property <bool> gear-focused;
    in property <string> toast;
    in property <bool> toast-visible;

    callback action(Action);
    callback notify(string);
    callback home-combo();
    // Controllers-screen data waits in a channel; this tells the app to read it.
    callback controller-event();
    callback back-released();
    callback back-hold-tick();
    // Empty message: the game ended normally; otherwise why it failed.
    callback game-ended(string);

    // 1px at 1080p; everything scales with the screen.
    property <length> u: min(root.width / 1920, root.height / 1080);
    property <length> margin: 96 * u;
    property <length> small: 100 * u;
    property <length> big: 164 * u;
    property <length> gap: 14 * u;
    property <length> row-y: 128 * u;
    property <length> card-w: 300 * u;
    property <length> card-gap: 20 * u;

    // --- Background: game art, or a soft gradient of the game's color without art ---
    Rectangle {
        background: @linear-gradient(135deg, backdrop.darker(0.2) 0%, backdrop.darker(0.75) 100%);
        animate background { duration: 450ms; }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: hero-a;
        image-fit: cover;
        opacity: has-hero && show-a ? 1 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: hero-b;
        image-fit: cover;
        opacity: has-hero && !show-a ? 1 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
    }

    // Scrims keep text readable on bright art: left for the logo, top for the row, bottom for cards.
    Rectangle {
        background: @linear-gradient(90deg, #000000c8 0%, #00000070 40%, #00000000 75%);
    }

    Rectangle {
        background: @linear-gradient(180deg, #000000b8 0%, #00000000 38%);
    }

    Rectangle {
        background: @linear-gradient(0deg, #000000e6 0%, #00000000 50%);
    }

    // --- Top bar: plain text tabs (PS5 "Games / Media"), gear and clock ---
    HorizontalLayout {
        x: margin - 16 * u;
        y: 36 * u;
        height: 56 * u;
        spacing: 18 * u;
        alignment: start;
        for tab[i] in tabs: Rectangle {
            horizontal-stretch: 0;
            border-radius: 12 * u;
            background: zone == Zone.tabs && i == current-tab && !gear-focused ? #ffffff26 : transparent;
            animate background { duration: 120ms; }
            HorizontalLayout {
                padding-left: 16 * u;
                padding-right: 16 * u;
                spacing: 8 * u;
                Text {
                    text: tab.name;
                    font-size: 32 * u;
                    font-weight: i == current-tab ? 600 : 300;
                    color: i == current-tab ? white : #ffffff8c;
                    vertical-alignment: center;
                }

                Text {
                    text: tab.count;
                    font-size: 18 * u;
                    color: #ffffff66;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        x: margin;
        y: 36 * u;
        width: root.width - 2 * margin;
        height: 56 * u;
        spacing: 40 * u;
        alignment: end;
        Rectangle {
            width: 56 * u;
            border-radius: 12 * u;
            background: gear-focused ? #ffffff26 : transparent;
            animate background { duration: 120ms; }
            Glyph {
                text: "\u{E713}";
                font-size: 28 * u;
            }
        }

        Text {
            text: clock;
            font-size: 30 * u;
            font-weight: 300;
            color: white;
            vertical-alignment: center;
        }
    }

    // --- Game row: the selection always sits in the first slot, like PS5 ---
    for tile[i] in icons: ArtTile {
        property <bool> is-selected: i == selected;
        tile: tile;
        ring: is-selected && zone == Zone.icons;
        u: u;
        title-size: (is-selected ? 20 : 14) * u;
        x: margin + (i - selected) * (small + gap) + (i > selected ? big - small : 0);
        y: row-y;
        width: is-selected ? big : small;
        height: self.width;
        visible: self.x > -big && self.x < root.width;
        animate x, width { duration: 170ms; easing: ease-out; }
    }

    Text {
        x: margin + big + gap + 6 * u;
        y: row-y + small + 14 * u;
        width: root.width - self.x - margin;
        text: game-title;
        font-size: 28 * u;
        font-weight: 300;
        color: white;
        overflow: elide;
    }

    if icons.length == 0: Text {
        x: margin;
        y: row-y + 40 * u;
        text: "No games here yet";
        font-size: 30 * u;
        font-weight: 300;
        color: #ffffffb3;
    }

    // --- Logo (or big title), actions and info ---
    if has-logo: Image {
        x: margin;
        y: 360 * u;
        width: 760 * u;
        height: 260 * u;
        source: logo;
        image-fit: contain;
        horizontal-alignment: left;
        vertical-alignment: bottom;
    }
    if !has-logo && icons.length > 0: Text {
        x: margin;
        y: 360 * u;
        width: 1000 * u;
        height: 260 * u;
        text: game-title;
        font-size: 84 * u;
        font-weight: 700;
        color: white;
        wrap: word-wrap;
        vertical-alignment: bottom;
    }

    if icons.length > 0: HorizontalLayout {
        x: margin;
        y: 650 * u;
        height: 68 * u;
        spacing: 16 * u;
        alignment: start;
        PillButton {
            focused: zone == Zone.actions && action-index == 0;
            u: u;
            width: 230 * u;
            HorizontalLayout {
                alignment: center;
                spacing: 12 * u;
                Glyph {
                    text: "\u{E768}";
                    font-size: 22 * u;
                    color: zone == Zone.actions && action-index == 0 ? black : white;
                }

                Text {
                    text: selected-running ? "Resume" : "Play";
                    font-size: 28 * u;
                    font-weight: 600;
                    color: zone == Zone.actions && action-index == 0 ? black : white;
                    vertical-alignment: center;
                }
            }
        }

        PillButton {
            focused: zone == Zone.actions && action-index == 1;
            u: u;
            width: self.height;
            Glyph {
                text: "\u{E712}";
                font-size: 24 * u;
                color: zone == Zone.actions && action-index == 1 ? black : white;
            }
        }

        Rectangle {
            width: 12 * u;
        }

        Text {
            text: (is-favorite ? "★  " : "") + info;
            font-size: 24 * u;
            font-weight: 300;
            color: #ffffffcc;
            vertical-alignment: center;
        }
    }

    // --- Recently played ---
    if recent.length > 0: Text {
        x: margin;
        y: 770 * u;
        text: "Recently played";
        font-size: 24 * u;
        font-weight: 300;
        color: #ffffffcc;
    }
    for card[i] in recent: ArtTile {
        property <int> scroll: Math.max(0, recent-index - 3);
        tile: card;
        ring: zone == Zone.recent && i == recent-index;
        u: u;
        x: margin + (i - scroll) * (card-w + card-gap);
        y: 812 * u;
        width: card-w;
        height: card-w * 9 / 16;
        border-radius: 10 * u;
        animate x { duration: 170ms; easing: ease-out; }
    }

    HorizontalLayout {
        x: margin;
        y: root.height - 52 * u;
        width: root.width - 2 * margin;
        height: 34 * u;
        alignment: end;
        spacing: 32 * u;
        ButtonHint {
            key: "A";
            label: zone == Zone.tabs ? (gear-focused ? "Menu" : "Open") : "Play";
            u: u;
        }

        ButtonHint {
            key: "Y";
            label: "Options";
            u: u;
        }

        ButtonHint {
            key: "LT/RT";
            label: "Jump";
            u: u;
        }

        ButtonHint {
            key: "≡";
            label: "Menu";
            u: u;
        }
    }

    // --- Game sheet (⋯ / Y) ---
    if sheet-open: Rectangle {
        background: #00000080;
        // Opens beside the ⋯ button and drops downward, so the game title stays visible.
        Rectangle {
            x: margin + 338 * u;
            y: 650 * u;
            width: 440 * u;
            height: sheet-items.length * 68 * u + 24 * u;
            border-radius: 18 * u;
            background: #161b26f5;
            border-width: 1px;
            border-color: #ffffff1f;
            drop-shadow-blur: 40 * u;
            drop-shadow-color: #00000099;
            for item[i] in sheet-items: Rectangle {
                x: 12 * u;
                y: 12 * u + i * 68 * u;
                width: parent.width - 24 * u;
                height: 64 * u;
                border-radius: 12 * u;
                background: i == sheet-index ? white : transparent;
                Text {
                    x: 22 * u;
                    height: parent.height;
                    text: item;
                    font-size: 26 * u;
                    color: i == sheet-index ? black : white;
                    vertical-alignment: center;
                }
            }
        }
    }

    // --- Quick panel (Menu button), Power and Settings ---
    if overlay != 0: Rectangle {
        background: #000000a0;
    }

    if overlay == 1 || overlay == 2: Rectangle {
        x: root.width - self.width;
        width: 620 * u;
        background: #0b1019f5;
        border-width: 1px;
        border-color: #ffffff14;
        Text {
            x: 56 * u;
            y: 56 * u;
            text: clock;
            font-size: 72 * u;
            font-weight: 200;
            color: white;
        }

        Text {
            x: 56 * u;
            y: 150 * u;
            text: date;
            font-size: 26 * u;
            font-weight: 300;
            color: #ffffffb3;
        }

        if overlay == 1: Rectangle {
            property <[{glyph: string, label: string}]> items: [
                { glyph: "\u{E713}", label: "Settings" },
                { glyph: "\u{E7FC}", label: "Controllers" },
                { glyph: "\u{E72C}", label: "Rescan library" },
                { glyph: "\u{E7E8}", label: "Power" },
                { glyph: "\u{E8BB}", label: "Exit launcher" },
            ];
            for item[i] in items: PanelTile {
                x: 56 * u + Math.mod(i, 2) * 264 * u;
                y: 250 * u + Math.floor(i / 2) * 204 * u;
                width: 244 * u;
                height: 184 * u;
                glyph: item.glyph;
                label: item.label;
                focused: i == panel-index;
                u: u;
            }
        }

        if overlay == 2: Rectangle {
            property <[string]> items: ["Sleep", "Restart", "Shut down", "Cancel"];
            Text {
                x: 56 * u;
                y: 250 * u;
                text: "Power";
                font-size: 34 * u;
                font-weight: 600;
                color: white;
            }

            for item[i] in items: Rectangle {
                x: 44 * u;
                y: 320 * u + i * 84 * u;
                width: parent.width - 88 * u;
                height: 72 * u;
                border-radius: 14 * u;
                background: i == power-index ? white : transparent;
                Text {
                    x: 24 * u;
                    height: parent.height;
                    text: item;
                    font-size: 28 * u;
                    color: i == power-index ? black : white;
                    vertical-alignment: center;
                }
            }
        }
    }

    if overlay == 3: Rectangle {
        property <[string]> labels: ["UI sounds volume", "Music volume"];
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 900 * u;
        height: 460 * u;
        border-radius: 24 * u;
        background: #0f1522f7;
        border-width: 1px;
        border-color: #ffffff1a;
        Text {
            x: 56 * u;
            y: 44 * u;
            text: "Settings";
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        for label[i] in labels: Rectangle {
            x: 40 * u;
            y: 140 * u + i * 96 * u;
            width: parent.width - 80 * u;
            height: 80 * u;
            border-radius: 16 * u;
            background: i == settings-index ? #ffffff1f : transparent;
            border-width: i == settings-index ? 2px : 0;
            border-color: #2d8cff;
            Text {
                x: 28 * u;
                height: parent.height;
                text: label;
                font-size: 28 * u;
                color: white;
                vertical-alignment: center;
            }

            // Fixed width so the arrows hug the value at the right end of the row.
            HorizontalLayout {
                width: 200 * u;
                x: parent.width - self.width - 28 * u;
                height: parent.height;
                spacing: 18 * u;
                alignment: center;
                Glyph {
                    text: "\u{E76B}";
                    font-size: 22 * u;
                    color: i == settings-index ? white : #ffffff66;
                }

                Text {
                    text: settings-values[i];
                    min-width: 90 * u;
                    font-size: 28 * u;
                    font-weight: 600;
                    color: i == settings-index ? white : #ffffffa6;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Glyph {
                    text: "\u{E76C}";
                    font-size: 22 * u;
                    color: i == settings-index ? white : #ffffff66;
                }
            }
        }

        Text {
            x: 56 * u;
            y: parent.height - 70 * u;
            text: "Left / Right to change  ·  B to go back";
            font-size: 22 * u;
            color: #ffffff80;
        }
    }

    // --- Controllers screen ---
    if overlay == 4: Rectangle {
        property <length> column-w: 460 * u;
        property <length> row-h: 60 * u;
        property <length> row-pitch: 66 * u;
        property <length> list-y: 170 * u;
        property <length> picture-x: margin + column-w + 60 * u;
        property <length> picture-w: root.width - 2 * picture-x;
        property <length> picture-y: 190 * u;
        property <length> ps: picture-w / 1000;
        property <length> box-y: picture-y + picture-w * 0.64 + 20 * u;
        // Where each input sits on the picture (design units), in controllers::ALL order.
        property <[{x: float, y: float}]> anchors: [
            { x: 305, y: 17 }, { x: 305, y: 59 }, { x: 440, y: 316 }, { x: 560, y: 316 }, { x: 500, y: 228 },
            { x: 300, y: 290 }, { x: 300, y: 222 }, { x: 246, y: 290 }, { x: 354, y: 290 }, { x: 300, y: 358 },
            { x: 390, y: 410 }, { x: 352, y: 448 }, { x: 428, y: 448 }, { x: 390, y: 486 },
            { x: 695, y: 17 }, { x: 695, y: 59 }, { x: 720, y: 230 }, { x: 660, y: 290 }, { x: 780, y: 290 }, { x: 720, y: 350 },
            { x: 620, y: 450 }, { x: 620, y: 382 }, { x: 566, y: 450 }, { x: 674, y: 450 }, { x: 620, y: 518 },
        ];
        property <RemapRow> selected-row: remap-rows[remap-index];
        property <length> row-x: selected-row.column == 0 ? margin : selected-row.column == 2 ? root.width - margin - column-w : (root.width - column-w) / 2;
        property <length> row-y: selected-row.column == 1 ? box-y + selected-row.row * row-pitch : list-y + selected-row.row * row-pitch;
        // Connector start: the row's edge facing the picture.
        property <length> line-x: selected-row.column == 0 ? row-x + column-w : selected-row.column == 2 ? row-x : row-x + column-w / 2;
        property <length> line-y: selected-row.column == 1 ? row-y : row-y + row-h / 2;
        property <length> end-x: picture-x + anchors[remap-index].x * ps;
        property <length> end-y: picture-y + anchors[remap-index].y * ps;

        background: @radial-gradient(circle, #1a2744 0%, #0d1320 45%, #080b12 100%);

        Text {
            x: margin;
            y: 40 * u;
            text: "Controllers";
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        Text {
            x: margin;
            y: 96 * u;
            text: controllers-title;
            font-size: 22 * u;
            font-weight: 300;
            color: #ffffffb3;
        }

        // Elbow line from the selected row to its button on the picture.
        Path {
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            stroke: #2d8cffc0;
            stroke-width: 2px;
            MoveTo {
                x: line-x / 1px;
                y: line-y / 1px;
            }

            LineTo {
                x: (selected-row.column == 1 ? line-x : (line-x + end-x) / 2) / 1px;
                y: (selected-row.column == 1 ? (line-y + end-y) / 2 : line-y) / 1px;
            }

            LineTo {
                x: end-x / 1px;
                y: end-y / 1px;
            }
        }

        ControllerPicture {
            x: picture-x;
            y: picture-y;
            width: picture-w;
            height: picture-w * 0.64;
            highlight: remap-index;
            live: live;
        }

        Rectangle {
            x: end-x - 5px;
            y: end-y - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: #9fd0ff;
        }

        for row[i] in remap-rows: RemapRowView {
            data: row;
            selected: i == remap-index;
            pressed: live[i];
            u: u;
            width: column-w;
            height: row-h;
            x: row.column == 0 ? margin : row.column == 2 ? root.width - margin - column-w : (root.width - column-w) / 2;
            y: row.column == 1 ? box-y + row.row * row-pitch : list-y + row.row * row-pitch;
        }

        HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 32 * u;
            ButtonHint {
                key: "A";
                label: "Add key or button";
                u: u;
            }

            ButtonHint {
                key: "Y";
                label: "Clear";
                u: u;
            }

            HorizontalLayout {
                spacing: 10 * u;
                HoldBadge {
                    progress: back-progress;
                    u: u;
                }

                Text {
                    text: "Hold to exit";
                    color: #ffffffa6;
                    font-size: 20 * u;
                    vertical-alignment: center;
                }
            }
        }

        if capturing: Rectangle {
            background: #000000b0;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 980 * u;
                height: 220 * u;
                border-radius: 24 * u;
                background: #121a2bfa;
                border-width: 2px;
                border-color: #2d8cff;
                drop-shadow-blur: 50 * u;
                drop-shadow-color: #2d8cff60;
                VerticalLayout {
                    alignment: center;
                    spacing: 14 * u;
                    padding: 30 * u;
                    Text {
                        text: capture-text;
                        font-size: 30 * u;
                        color: white;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Waiting a few seconds… press nothing to cancel";
                        font-size: 20 * u;
                        color: #ffffff80;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // Messages sit in the empty band between the game row and the title, clear of every row.
    Rectangle {
        // Beside the quick panel while it is open, so messages never cover its tiles.
        x: (overlay == 1 || overlay == 2 ? root.width - 620 * u : root.width) - margin - self.width;
        // The Controllers screen fills the band below the header, so messages use the header's corner there.
        y: overlay == 4 ? 44 * u : 320 * u;
        width: min(toast-text.preferred-width + 60 * u, root.width - 2 * margin);
        height: 60 * u;
        border-radius: self.height / 2;
        background: #141a26f2;
        border-width: 1px;
        border-color: #ffffff26;
        opacity: toast-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        toast-text := Text {
            x: 30 * u;
            width: parent.width - 60 * u;
            height: parent.height;
            text: toast;
            color: white;
            font-size: 22 * u;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    keys := FocusScope {
        key-released(event) => {
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.back-released();
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.action(Action.up);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.action(Action.down);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.action(Action.left);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.action(Action.right);
                return accept;
            }
            if (event.text == Key.Return) {
                root.action(Action.confirm);
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.action(Action.back);
                return accept;
            }
            if (event.text == Key.Space) {
                root.action(Action.options);
                return accept;
            }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.action(Action.tab-prev);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.action(Action.tab-next);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.action(Action.page-prev);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.action(Action.page-next);
                return accept;
            }
            if (event.text == Key.F1) {
                root.action(Action.menu);
                return accept;
            }
            return reject;
        }
    }

    // Controller-first: the mouse pointer is hidden over the launcher.
    TouchArea {
        mouse-cursor: none;
    }

    init => {
        keys.focus();
    }
}
