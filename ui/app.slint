import { ControllerPicture } from "controller_picture.slint";

export enum Action { up, down, left, right, confirm, back, options, tab-prev, tab-next, page-prev, page-next, menu }

export enum Zone { tabs, icons, actions, recent }

// What a mouse click landed on; main.rs turns it into the same steps a controller would take.
export enum Target { none, tab, gear, tile, play, more, recent, sheet-item, sheet-outside, dismiss, panel-tile, power-item, settings-row, settings-step, remap-row, hold-exit, add-row, art-thumb, remap-button, controller-mode, remap-command }

// Mouse input for the whole window. The pointer only shows while the mouse is being used.
export global Mouse {
    in-out property <bool> visible;
    // Left click on a target; `a` and `b` say which one (index, or row and index).
    callback clicked(Target, int, int);
    // Right click anywhere: back.
    callback back();
    // Wheel: +1 down / right, -1 up / left.
    callback wheel(int);
    // A clicked button hint: the action its button stands for.
    callback act(Action);
    callback moved();
}

// A clickable area. Right click and the wheel work over it too.
component Hit inherits TouchArea {
    in property <Target> target;
    in property <int> a;
    in property <int> b;
    mouse-cursor: !Mouse.visible ? MouseCursor.none : target == Target.none ? MouseCursor.default : MouseCursor.pointer;
    clicked => {
        Mouse.clicked(target, a, b);
    }
    pointer-event(event) => {
        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
            Mouse.back();
        }
    }
    scroll-event(event) => {
        Mouse.wheel(event.delta-y > 0 ? -1 : event.delta-y < 0 ? 1 : 0);
        accept
    }
    changed mouse-x => {
        Mouse.moved();
    }
    changed mouse-y => {
        Mouse.moved();
    }
}

export struct Tile {
    title: string,
    color: color,
    icon: image,
    has-icon: bool,
    // False while the game's drive or files are missing: the tile is greyed out.
    available: bool,
    // Segoe MDL2 glyph explaining why (unplugged drive, missing files); empty when available.
    badge: string,
}

// A quick-panel tile: big glyph above a label (BuzzTV-style square buttons).
component PanelTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> focused;
    in property <length> u;
    border-radius: 20 * u;
    background: focused ? #2d8cff : #ffffff12;
    border-width: focused ? 0 : 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: focused ? 28 * u : 0;
    drop-shadow-color: #2d8cff80;
    animate background { duration: 120ms; }
    VerticalLayout {
        alignment: center;
        spacing: 14 * u;
        Text {
            text: glyph;
            font-family: "Segoe MDL2 Assets";
            font-size: 46 * u;
            color: white;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: 24 * u;
            color: white;
            horizontal-alignment: center;
        }
    }
}

export struct RemapRow {
    badge: string,
    label: string,
    value: string,
    column: int,
    row: int,
}

component RemapRowView inherits Rectangle {
    in property <RemapRow> data;
    in property <bool> selected;
    in property <bool> pressed;
    in property <length> u;
    border-radius: 12 * u;
    background: selected ? @linear-gradient(90deg, #2d8cff40 0%, #2d8cff14 100%) : pressed ? #ffffff1f : #ffffff07;
    border-width: 1px;
    border-color: selected ? #2d8cffb0 : #ffffff0f;
    animate background { duration: 90ms; }
    // Accent bar on the selected row.
    Rectangle {
        x: 0;
        y: 10 * u;
        width: 4 * u;
        height: parent.height - 20 * u;
        border-radius: 2 * u;
        background: selected ? #2d8cff : transparent;
    }

    HorizontalLayout {
        padding-left: 16 * u;
        padding-right: 16 * u;
        spacing: 14 * u;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40 * u;
                height: 40 * u;
                border-radius: 20 * u;
                background: pressed ? white : selected ? #2d8cff : #ffffff14;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: data.badge;
                    font-size: 15 * u;
                    font-weight: 700;
                    color: pressed ? black : white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1 * u;
            Text {
                text: data.label;
                font-size: 21 * u;
                font-weight: selected ? 600 : 400;
                color: white;
                overflow: elide;
            }

            Text {
                text: data.value == "" ? "Default" : data.value;
                font-size: 16 * u;
                color: data.value == "" ? #ffffff4d : #8cc4ff;
                overflow: elide;
            }
        }
    }
}

// A clickable pill on the Controllers screen's remap panel and dialogs.
component CommandButton inherits Rectangle {
    in property <string> label;
    in property <int> command;
    in property <bool> primary;
    in property <length> u;
    height: 52 * u;
    border-radius: 26 * u;
    background: primary ? #2d8cff : hit.has-hover && Mouse.visible ? #ffffff2e : #ffffff17;
    border-width: 1px;
    border-color: primary ? transparent : #ffffff26;
    HorizontalLayout {
        padding-left: 28 * u;
        padding-right: 28 * u;
        Text {
            text: label;
            font-size: 21 * u;
            color: white;
            vertical-alignment: center;
        }
    }

    hit := Hit {
        target: Target.remap-command;
        a: command;
    }
}

// The B badge with a ring that fills while B is held (hold to leave the Controllers screen).
component HoldBadge inherits Rectangle {
    in property <float> progress;
    in property <length> u;
    width: 46 * u;
    height: 46 * u;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 3 * u;
        border-color: #ffffff33;
    }

    if progress > 0.001: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: #2d8cff;
        stroke-width: 3 * u;
        commands: "M 50 3.5 A 46.5 46.5 0 " + (progress > 0.5 ? "1" : "0") + " 1 " + (50 + 46.5 * Math.sin(progress * 360deg)) + " " + (50 - 46.5 * Math.cos(progress * 360deg));
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "B";
        font-size: 18 * u;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct AddRow {
    title: string,
    // The exe that will be launched, or the path of a drive or folder.
    detail: string,
    // Segoe MDL2 glyph in the round badge.
    icon: string,
    // 0 normal, 1 done (green), 2 dimmed (ignored)
    tone: int,
    // What A does, written on the selected row ("Add to library", "Open"); empty for none.
    action: string,
    // Text at the right end ("Added", "Ignored").
    note: string,
    // "exe 1 of 3" when Left/Right can pick another exe; empty otherwise.
    choice: string,
}

component AddRowView inherits Rectangle {
    in property <AddRow> data;
    in property <bool> selected;
    in property <length> u;
    border-radius: 14 * u;
    background: selected ? @linear-gradient(90deg, #2d8cff40 0%, #2d8cff14 100%) : #ffffff07;
    border-width: 1px;
    border-color: selected ? #2d8cffb0 : #ffffff0f;
    opacity: data.tone == 2 && !selected ? 0.55 : 1;
    animate background { duration: 90ms; }
    Rectangle {
        x: 0;
        y: 12 * u;
        width: 4 * u;
        height: parent.height - 24 * u;
        border-radius: 2 * u;
        background: selected ? #2d8cff : transparent;
    }

    HorizontalLayout {
        padding-left: 20 * u;
        padding-right: 20 * u;
        spacing: 18 * u;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48 * u;
                height: 48 * u;
                border-radius: 24 * u;
                background: data.tone == 1 ? #2ecc71 : selected ? #2d8cff : #ffffff14;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: data.icon;
                    font-family: "Segoe MDL2 Assets";
                    font-size: 22 * u;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Takes the spare width, so the choice and the status sit at the right end.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4 * u;
            Text {
                text: data.title;
                font-size: 26 * u;
                font-weight: selected ? 600 : 400;
                color: white;
                overflow: elide;
            }

            Text {
                text: data.detail;
                font-size: 17 * u;
                color: #ffffff73;
                overflow: elide;
            }
        }

        if selected && data.choice != "": HorizontalLayout {
            spacing: 10 * u;
            alignment: center;
            Text {
                text: "\u{E76B}";
                font-family: "Segoe MDL2 Assets";
                font-size: 16 * u;
                color: #ffffffb3;
                vertical-alignment: center;
            }

            Text {
                text: data.choice;
                font-size: 18 * u;
                color: #ffffffb3;
                vertical-alignment: center;
            }

            Text {
                text: "\u{E76C}";
                font-family: "Segoe MDL2 Assets";
                font-size: 16 * u;
                color: #ffffffb3;
                vertical-alignment: center;
            }
        }

        // The action is written on the row itself, so A always says what it will do.
        if selected && data.action != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: action-label.preferred-width + 76 * u;
                height: 48 * u;
                border-radius: 24 * u;
                background: white;
                HorizontalLayout {
                    padding-left: 10 * u;
                    padding-right: 22 * u;
                    spacing: 12 * u;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 30 * u;
                            height: 30 * u;
                            border-radius: 15 * u;
                            background: #101521;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "A";
                                font-size: 15 * u;
                                font-weight: 700;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    action-label := Text {
                        text: data.action;
                        font-size: 20 * u;
                        font-weight: 600;
                        color: #101521;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if data.note != "": Text {
            text: data.note;
            font-size: data.tone == 1 ? 20 * u : 18 * u;
            font-weight: data.tone == 1 ? 600 : 400;
            color: data.tone == 1 ? #2ecc71 : #ffffffa6;
            vertical-alignment: center;
        }
    }
}

export struct ArtThumb {
    image: image,
    // False for the "None" choice.
    has-image: bool,
    in-use: bool,
}

export struct ArtRow {
    name: string,
    // "3 of 9 · Steam · God of War"
    label: string,
    focus: int,
    thumbs: [ArtThumb],
}

// One picture on the Choose art screen.
component ArtThumbView inherits Rectangle {
    in property <ArtThumb> data;
    in property <bool> selected;
    in property <bool> row-active;
    // Logos sit on a dark plate, shown whole; covers and backgrounds fill their box.
    in property <bool> plate;
    in property <length> u;
    border-radius: 12 * u;
    background: data.has-image ? (plate ? #0b0f17 : #101521) : #ffffff08;
    clip: true;
    // A picture much wider than its box (a store banner in the cover row) is shown whole on the
    // plate color instead of being cropped to a sliver.
    property <bool> whole: plate || data.image.width * root.height > data.image.height * root.width * 2.2;
    if data.has-image: Image {
        x: whole ? 12 * u : 0;
        y: whole ? 12 * u : 0;
        width: parent.width - (whole ? 24 * u : 0);
        height: parent.height - (whole ? 24 * u : 0);
        source: data.image;
        image-fit: whole ? ImageFit.contain : ImageFit.cover;
    }
    if !data.has-image: Text {
        width: parent.width;
        height: parent.height;
        text: "None";
        font-size: 24 * u;
        color: #ffffff8c;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if data.in-use: Rectangle {
        x: parent.width - self.width - 8 * u;
        y: 8 * u;
        width: in-use-text.preferred-width + 20 * u;
        height: 28 * u;
        border-radius: self.height / 2;
        background: #2ecc71;
        in-use-text := Text {
            width: parent.width;
            height: parent.height;
            text: "In use";
            font-size: 15 * u;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        border-radius: parent.border-radius;
        border-width: selected ? (row-active ? 4 * u : 2 * u) : (data.has-image ? 0 : 1px);
        border-color: selected ? (row-active ? white : #ffffff59) : #ffffff33;
    }
}

export struct TabInfo {
    name: string,
    count: int,
}

// Segoe MDL2 Assets ships with Windows 10 and 11 and holds the system UI glyphs.
component Glyph inherits Text {
    font-family: "Segoe MDL2 Assets";
    color: white;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <length> u;
    width: max(self.height, txt.preferred-width + 18 * u);
    height: 32 * u;
    border-radius: self.height / 2;
    border-width: 1.5 * u;
    border-color: #ffffff59;
    txt := Text {
        width: parent.width;
        height: parent.height;
        text: label;
        color: #ffffffd9;
        font-size: 16 * u;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A button hint ("A Play"); clicking it does what the button does.
component ButtonHint inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <length> u;
    property <Action> act: key == "A" ? Action.confirm : key == "B" ? Action.back : key == "Y" ? Action.options : key == "LB" ? Action.tab-prev : key == "RB" ? Action.tab-next : key == "LT/RT" ? Action.page-next : key == "≡" ? Action.menu : key == "← →" ? Action.right : key == "↑ ↓" ? Action.down : Action.confirm;
    border-radius: 10 * u;
    background: hint-hit.has-hover && Mouse.visible ? #ffffff1a : transparent;
    HorizontalLayout {
        padding-left: 6 * u;
        padding-right: 6 * u;
        spacing: 10 * u;
        VerticalLayout {
            alignment: center;
            Badge { label: key; u: u; }
        }
        Text {
            text: label;
            color: #ffffffa6;
            font-size: 20 * u;
            vertical-alignment: center;
        }
    }
    hint-hit := TouchArea {
        mouse-cursor: Mouse.visible ? MouseCursor.pointer : MouseCursor.none;
        clicked => {
            Mouse.act(act);
        }
        changed mouse-x => {
            Mouse.moved();
        }
    }
}

// Game art in a rounded tile. Wide art (PS3 icons are 320x176) is shown whole over a
// dimmed, cropped copy of itself instead of having its title cropped off.
component ArtTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> ring;
    in property <length> u;
    in property <length> title-size: 18 * u;
    property <bool> wide: tile.icon.width > tile.icon.height * 1.2;
    border-radius: 14 * u;
    background: tile.has-icon ? #0c0f16 : tile.color;
    clip: true;
    if tile.has-icon && wide: Image {
        width: parent.width;
        height: parent.height;
        source: tile.icon;
        image-fit: cover;
        opacity: 0.35;
    }
    if tile.has-icon: Image {
        width: parent.width;
        height: parent.height;
        source: tile.icon;
        image-fit: wide ? contain : cover;
    }
    if !tile.has-icon: Text {
        x: 10 * u;
        width: parent.width - 20 * u;
        height: parent.height;
        text: tile.title;
        font-size: title-size;
        font-weight: 600;
        color: white;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !tile.available: Rectangle {
        background: #05070bb8;
        Rectangle {
            x: parent.width - self.width - 8 * u;
            y: 8 * u;
            width: 30 * u;
            height: 30 * u;
            border-radius: self.width / 2;
            background: #000000c0;
            Text {
                width: parent.width;
                height: parent.height;
                text: tile.badge;
                font-family: "Segoe MDL2 Assets";
                font-size: 15 * u;
                color: #ffffffd9;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        border-radius: parent.border-radius;
        border-width: ring ? 4 * u : 0;
        border-color: white;
    }
}

component PillButton inherits Rectangle {
    in property <bool> focused;
    in property <length> u;
    border-radius: self.height / 2;
    background: focused ? white : #ffffff29;
    border-width: focused ? 0 : 1px;
    border-color: #ffffff33;
    drop-shadow-blur: focused ? 24 * u : 0;
    drop-shadow-color: #ffffff40;
    animate background { duration: 120ms; }
}

export component AppWindow inherits Window {
    title: "JustPlay - Game Launcher";
    icon: @image-url("../assets/icon-256.png");
    background: #05070b;
    default-font-family: "Segoe UI";
    preferred-width: 1600px;
    preferred-height: 900px;

    in property <[TabInfo]> tabs;
    in property <int> current-tab;
    in property <Zone> zone;
    in property <[Tile]> icons;
    in property <int> selected;
    in property <int> action-index;
    in property <[Tile]> recent;
    in property <int> recent-index;

    // Two background layers crossfade: the new art goes on the hidden one, then they swap.
    in property <image> hero-a;
    in property <image> hero-b;
    in property <bool> show-a: true;
    in property <bool> has-hero;
    in property <color> backdrop: #1b2236;

    in property <string> game-title;
    in property <string> info;
    in property <image> logo;
    in property <bool> has-logo;
    in property <bool> is-favorite;
    in property <bool> selected-running;
    in property <bool> selected-available: true;

    in property <bool> sheet-open;
    in property <[string]> sheet-items;
    in property <int> sheet-index;

    in property <string> clock;
    in property <string> date;

    // 0 none, 1 quick panel, 2 power, 3 settings, 4 controllers, 5 add games, 6 choose art
    in property <int> overlay;
    in property <int> panel-index;
    in property <int> power-index;
    in property <int> settings-index;
    in property <[string]> settings-values;

    in property <string> controllers-title;
    in property <[RemapRow]> remap-rows;
    in property <int> remap-index;
    in property <[bool]> live;
    in property <bool> capturing;
    in property <string> capture-text;
    in property <bool> capture-can-clear;
    // No games at all yet (first start): Home shows the welcome screen.
    in property <bool> library-empty;
    // Settings > Background dimming, 0-1.
    in property <float> background-dim;
    // The button lit on the picture and its row: the focused one (Focus mode) or the one being
    // remapped; -1 for none (Test mode).
    in property <int> remap-highlight: -1;
    // 0 Test, 1 Focus, 2 Remap all.
    in property <int> controllers-mode;
    in property <bool> multiple-pads;
    // A remap in progress: 0 one button, 1 all buttons, 2 asking about a stick.
    in property <bool> run-active;
    in property <int> run-kind;
    in property <string> run-title;
    in property <string> run-detail;
    in property <bool> run-can-back;
    in property <float> back-progress;
    // Controllers screen: how far a held button is toward its action, and what it will do.
    in property <float> hold-progress;
    in property <string> hold-text;
    in property <bool> gear-focused;
    in property <[AddRow]> add-rows;
    in property <int> add-index;
    in property <bool> add-scanning;
    in property <string> add-status;
    // 0 results, 1 where to look, 2 folder browser
    in property <int> add-mode;
    in property <[ArtRow]> art-rows;
    in property <int> art-slot;
    in property <string> art-title;
    in property <string> art-status;
    in property <string> add-title: "Add games";
    in property <string> add-place;
    in property <string> toast;
    in property <bool> toast-visible;

    callback action(Action);
    callback notify(string);
    callback home-combo();
    // Controllers-screen data waits in a channel; this tells the app to read it.
    callback controller-event();
    callback back-released();
    callback back-hold-tick();
    // An action from a pad (keyboard actions come through `action`).
    callback pad-action(Action);
    // Times holds on the Controllers screen.
    callback hold-tick();
    // While a game runs: note which screen its window is on (diagnostics).
    callback game-screen-check();
    // Empty message: the game ended normally; otherwise why it failed.
    callback game-ended(string);
    // A worker thread (background decoding, art download) has results waiting.
    callback background-event();

    // 1px at 1080p; everything scales with the screen.
    property <length> u: min(root.width / 1920, root.height / 1080);
    property <length> margin: 96 * u;
    property <length> small: 100 * u;
    property <length> big: 164 * u;
    property <length> gap: 14 * u;
    property <length> row-y: 128 * u;
    property <length> card-w: 300 * u;
    property <length> card-gap: 20 * u;

    // Underneath everything: right click (back), the wheel and showing the pointer work anywhere.
    Hit { }

    // --- Background: game art, or a soft gradient of the game's color without art ---
    Rectangle {
        background: @linear-gradient(135deg, backdrop.darker(0.2) 0%, backdrop.darker(0.75) 100%);
        animate background { duration: 450ms; }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: hero-a;
        image-fit: cover;
        opacity: has-hero && show-a ? 1 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: hero-b;
        image-fit: cover;
        opacity: has-hero && !show-a ? 1 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
    }

    // Settings > Background dimming: darkens the art evenly (at most 85%, so it never goes black).
    Rectangle {
        background: black;
        opacity: background-dim * 0.85;
        animate opacity { duration: 150ms; }
    }

    // Scrims keep text readable on bright art: left for the logo, top for the row, bottom for cards.
    Rectangle {
        background: @linear-gradient(90deg, #000000c8 0%, #00000070 40%, #00000000 75%);
    }

    Rectangle {
        background: @linear-gradient(180deg, #000000b8 0%, #00000000 38%);
    }

    Rectangle {
        background: @linear-gradient(0deg, #000000e6 0%, #00000000 50%);
    }

    // --- Top bar: plain text tabs (PS5 "Games / Media"), gear and clock ---
    HorizontalLayout {
        x: margin - 16 * u;
        y: 36 * u;
        height: 56 * u;
        spacing: 18 * u;
        alignment: start;
        for tab[i] in tabs: Rectangle {
            horizontal-stretch: 0;
            border-radius: 12 * u;
            background: zone == Zone.tabs && i == current-tab && !gear-focused ? #ffffff26 : transparent;
            Hit {
                target: Target.tab;
                a: i;
            }
            animate background { duration: 120ms; }
            HorizontalLayout {
                padding-left: 16 * u;
                padding-right: 16 * u;
                spacing: 8 * u;
                Text {
                    text: tab.name;
                    font-size: 32 * u;
                    font-weight: i == current-tab ? 600 : 300;
                    color: i == current-tab ? white : #ffffff8c;
                    vertical-alignment: center;
                }

                Text {
                    text: tab.count;
                    font-size: 18 * u;
                    color: #ffffff66;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        x: margin;
        y: 36 * u;
        width: root.width - 2 * margin;
        height: 56 * u;
        spacing: 40 * u;
        alignment: end;
        Rectangle {
            width: 56 * u;
            border-radius: 12 * u;
            background: gear-focused ? #ffffff26 : transparent;
            Hit {
                target: Target.gear;
            }
            animate background { duration: 120ms; }
            Glyph {
                text: "\u{E713}";
                font-size: 28 * u;
            }
        }

        Text {
            text: clock;
            font-size: 30 * u;
            font-weight: 300;
            color: white;
            vertical-alignment: center;
        }
    }

    // --- Game row: the selection always sits in the first slot, like PS5 ---
    for tile[i] in icons: ArtTile {
        property <bool> is-selected: i == selected;
        tile: tile;
        ring: is-selected && zone == Zone.icons;
        Hit {
            target: Target.tile;
            a: i;
        }
        u: u;
        title-size: (is-selected ? 20 : 14) * u;
        x: margin + (i - selected) * (small + gap) + (i > selected ? big - small : 0);
        y: row-y;
        width: is-selected ? big : small;
        height: self.width;
        visible: self.x > -big && self.x < root.width;
        animate x, width { duration: 170ms; easing: ease-out; }
    }

    Text {
        x: margin + big + gap + 6 * u;
        y: row-y + small + 14 * u;
        width: root.width - self.x - margin;
        text: game-title;
        font-size: 28 * u;
        font-weight: 300;
        color: white;
        overflow: elide;
    }

    if icons.length == 0 && !library-empty: Text {
        x: margin;
        y: row-y + 40 * u;
        text: "No games here yet";
        font-size: 30 * u;
        font-weight: 300;
        color: #ffffffb3;
    }

    // First start: one clear next step instead of an empty screen. A (or a click) finds games.
    if library-empty: VerticalLayout {
        x: margin;
        y: 280 * u;
        width: 1100 * u;
        height: self.preferred-height;
        alignment: start;
        spacing: 22 * u;
        Text {
            text: "Welcome to JustPlay";
            font-size: 64 * u;
            font-weight: 600;
            color: white;
        }

        Text {
            text: "Let's find your games. JustPlay looks through your drives for installed games, and you pick the ones to add.";
            font-size: 28 * u;
            font-weight: 300;
            color: #ffffffcc;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: start;
            padding-top: 20 * u;
            Rectangle {
                height: 76 * u;
                border-radius: 38 * u;
                background: welcome-hit.has-hover && Mouse.visible ? #4d9fff : #2d8cff;
                drop-shadow-blur: 30 * u;
                drop-shadow-color: #2d8cff80;
                HorizontalLayout {
                    padding-left: 30 * u;
                    padding-right: 40 * u;
                    spacing: 16 * u;
                    VerticalLayout {
                        alignment: center;
                        Badge {
                            label: "A";
                            u: u;
                        }
                    }

                    Text {
                        text: "Find my games";
                        font-size: 30 * u;
                        font-weight: 600;
                        color: white;
                        vertical-alignment: center;
                    }
                }

                welcome-hit := TouchArea {
                    mouse-cursor: Mouse.visible ? MouseCursor.pointer : MouseCursor.none;
                    clicked => {
                        Mouse.act(Action.confirm);
                    }
                    changed mouse-x => {
                        Mouse.moved();
                    }
                }
            }
        }

        Text {
            text: "You can also add a game's folder yourself, or set up emulators and controllers, from the menu (≡).";
            font-size: 22 * u;
            color: #ffffff80;
            wrap: word-wrap;
        }
    }

    // --- Logo (or big title), actions and info ---
    if has-logo: Image {
        x: margin;
        y: 360 * u;
        width: 760 * u;
        height: 260 * u;
        source: logo;
        image-fit: contain;
        horizontal-alignment: left;
        vertical-alignment: bottom;
    }
    if !has-logo && icons.length > 0: Text {
        x: margin;
        y: 360 * u;
        width: 1000 * u;
        height: 260 * u;
        text: game-title;
        font-size: 84 * u;
        font-weight: 700;
        color: white;
        wrap: word-wrap;
        vertical-alignment: bottom;
    }

    if icons.length > 0: HorizontalLayout {
        x: margin;
        y: 650 * u;
        height: 68 * u;
        spacing: 16 * u;
        alignment: start;
        PillButton {
            focused: zone == Zone.actions && action-index == 0;
            Hit {
                target: Target.play;
            }
            u: u;
            width: 230 * u;
            // Still focusable: pressing it says which drive to connect.
            opacity: selected-available ? 1 : 0.45;
            HorizontalLayout {
                alignment: center;
                spacing: 12 * u;
                Glyph {
                    text: "\u{E768}";
                    font-size: 22 * u;
                    color: zone == Zone.actions && action-index == 0 ? black : white;
                }

                Text {
                    text: selected-running ? "Resume" : "Play";
                    font-size: 28 * u;
                    font-weight: 600;
                    color: zone == Zone.actions && action-index == 0 ? black : white;
                    vertical-alignment: center;
                }
            }
        }

        PillButton {
            focused: zone == Zone.actions && action-index == 1;
            Hit {
                target: Target.more;
            }
            u: u;
            width: self.height;
            Glyph {
                text: "\u{E712}";
                font-size: 24 * u;
                color: zone == Zone.actions && action-index == 1 ? black : white;
            }
        }

        Rectangle {
            width: 12 * u;
        }

        Text {
            text: (is-favorite ? "★  " : "") + info;
            font-size: 24 * u;
            font-weight: 300;
            color: #ffffffcc;
            vertical-alignment: center;
        }
    }

    // --- Recently played ---
    if recent.length > 0: Text {
        x: margin;
        y: 770 * u;
        text: "Recently played";
        font-size: 24 * u;
        font-weight: 300;
        color: #ffffffcc;
    }
    for card[i] in recent: ArtTile {
        property <int> scroll: Math.max(0, recent-index - 3);
        tile: card;
        ring: zone == Zone.recent && i == recent-index;
        Hit {
            target: Target.recent;
            a: i;
        }
        u: u;
        x: margin + (i - scroll) * (card-w + card-gap);
        y: 812 * u;
        width: card-w;
        height: card-w * 9 / 16;
        border-radius: 10 * u;
        animate x { duration: 170ms; easing: ease-out; }
    }

    HorizontalLayout {
        x: margin;
        y: root.height - 52 * u;
        width: root.width - 2 * margin;
        height: 34 * u;
        alignment: end;
        spacing: 32 * u;
        ButtonHint {
            key: "A";
            label: library-empty ? "Find my games" : zone == Zone.tabs ? (gear-focused ? "Menu" : "Open") : "Play";
            u: u;
        }

        if !library-empty: ButtonHint {
            key: "Y";
            label: "Options";
            u: u;
        }

        if !library-empty: ButtonHint {
            key: "LT/RT";
            label: "Jump";
            u: u;
        }

        ButtonHint {
            key: "≡";
            label: "Menu";
            u: u;
        }
    }

    // --- Game sheet (⋯ / Y) ---
    if sheet-open: Rectangle {
        background: #00000080;
        Hit {
            target: Target.sheet-outside;
        }

        // Opens beside the ⋯ button and drops downward, so the game title stays visible.
        Rectangle {
            x: margin + 338 * u;
            y: 650 * u;
            width: 440 * u;
            height: sheet-items.length * 68 * u + 24 * u;
            border-radius: 18 * u;
            background: #161b26f5;
            border-width: 1px;
            border-color: #ffffff1f;
            drop-shadow-blur: 40 * u;
            drop-shadow-color: #00000099;
            Hit { }
            for item[i] in sheet-items: Rectangle {
                x: 12 * u;
                y: 12 * u + i * 68 * u;
                width: parent.width - 24 * u;
                height: 64 * u;
                border-radius: 12 * u;
                background: i == sheet-index ? white : transparent;
                Hit {
                    target: Target.sheet-item;
                    a: i;
                }
                Text {
                    x: 22 * u;
                    height: parent.height;
                    text: item;
                    font-size: 26 * u;
                    color: i == sheet-index ? black : white;
                    vertical-alignment: center;
                }
            }
        }
    }

    // --- Quick panel (Menu button), Power and Settings ---
    if overlay != 0: Rectangle {
        background: #000000a0;
        Hit {
            target: Target.dismiss;
        }
    }

    if overlay == 1 || overlay == 2: Rectangle {
        x: root.width - self.width;
        Hit { }

        width: 620 * u;
        background: #0b1019f5;
        border-width: 1px;
        border-color: #ffffff14;
        Text {
            x: 56 * u;
            y: 56 * u;
            text: clock;
            font-size: 72 * u;
            font-weight: 200;
            color: white;
        }

        Text {
            x: 56 * u;
            y: 150 * u;
            text: date;
            font-size: 26 * u;
            font-weight: 300;
            color: #ffffffb3;
        }

        if overlay == 1: Rectangle {
            property <[{glyph: string, label: string}]> items: [
                { glyph: "\u{E713}", label: "Settings" },
                { glyph: "\u{E7FC}", label: "Controllers" },
                { glyph: "\u{ECCD}", label: "Add games" },
                { glyph: "\u{E72C}", label: "Rescan library" },
                { glyph: "\u{E7E8}", label: "Power" },
                { glyph: "\u{E8BB}", label: "Exit launcher" },
            ];
            for item[i] in items: PanelTile {
                x: 56 * u + Math.mod(i, 2) * 264 * u;
                y: 250 * u + Math.floor(i / 2) * 204 * u;
                width: 244 * u;
                height: 184 * u;
                glyph: item.glyph;
                label: item.label;
                focused: i == panel-index;
                Hit {
                    target: Target.panel-tile;
                    a: i;
                }
                u: u;
            }
        }

        if overlay == 2: Rectangle {
            property <[string]> items: ["Sleep", "Restart", "Shut down", "Cancel"];
            Text {
                x: 56 * u;
                y: 250 * u;
                text: "Power";
                font-size: 34 * u;
                font-weight: 600;
                color: white;
            }

            for item[i] in items: Rectangle {
                x: 44 * u;
                y: 320 * u + i * 84 * u;
                width: parent.width - 88 * u;
                height: 72 * u;
                border-radius: 14 * u;
                background: i == power-index ? white : transparent;
                Hit {
                    target: Target.power-item;
                    a: i;
                }
                Text {
                    x: 24 * u;
                    height: parent.height;
                    text: item;
                    font-size: 28 * u;
                    color: i == power-index ? black : white;
                    vertical-alignment: center;
                }
            }
        }
    }

    if overlay == 3: Rectangle {
        property <[string]> labels: ["UI sounds volume", "Music volume", "Background dimming", "Launcher screen", "Games play on", "Game sound"];
        Hit { }

        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 1100 * u;
        height: 842 * u;
        border-radius: 24 * u;
        background: #0f1522f7;
        border-width: 1px;
        border-color: #ffffff1a;
        Text {
            x: 56 * u;
            y: 44 * u;
            text: "Settings";
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        for label[i] in labels: Rectangle {
            x: 40 * u;
            y: 140 * u + i * 96 * u;
            width: parent.width - 80 * u;
            height: 80 * u;
            border-radius: 16 * u;
            background: i == settings-index ? #ffffff1f : transparent;
            Hit {
                target: Target.settings-row;
                a: i;
            }
            border-width: i == settings-index ? 2px : 0;
            border-color: #2d8cff;
            Text {
                x: 28 * u;
                height: parent.height;
                text: label;
                font-size: 28 * u;
                color: white;
                vertical-alignment: center;
            }

            // Fixed width so the arrows hug the value at the right end of the row.
            HorizontalLayout {
                width: 460 * u;
                x: parent.width - self.width - 28 * u;
                height: parent.height;
                spacing: 18 * u;
                alignment: center;
                Glyph {
                    text: "\u{E76B}";
                    font-size: 22 * u;
                    color: i == settings-index ? white : #ffffff66;
                }

                Text {
                    text: settings-values[i];
                    width: 380 * u;
                    overflow: elide;
                    font-size: 28 * u;
                    font-weight: 600;
                    color: i == settings-index ? white : #ffffffa6;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Glyph {
                    text: "\u{E76C}";
                    font-size: 22 * u;
                    color: i == settings-index ? white : #ffffff66;
                }
            }

            // The arrows step the value, like Left / Right.
            Hit {
                x: parent.width - 498 * u;
                width: 70 * u;
                target: Target.settings-step;
                a: i;
                b: -1;
            }

            Hit {
                x: parent.width - 98 * u;
                width: 70 * u;
                target: Target.settings-step;
                a: i;
                b: 1;
            }
        }

        Text {
            x: 56 * u;
            y: parent.height - 70 * u;
            text: "Left / Right to change  ·  B to go back";
            font-size: 22 * u;
            color: #ffffff80;
        }
    }

    // --- Controllers screen ---
    if overlay == 4: Rectangle {
        property <length> column-w: 460 * u;
        property <length> row-h: 60 * u;
        property <length> row-pitch: 66 * u;
        property <length> list-y: 170 * u;
        property <length> picture-x: margin + column-w + 60 * u;
        property <length> picture-w: root.width - 2 * picture-x;
        property <length> picture-y: 190 * u;
        property <length> ps: picture-w / 1000;
        property <length> picture-h: picture-w * picture.aspect;
        property <length> box-y: picture-y + picture-h + 20 * u;
        // Where each input sits on the picture (units of picture-w / 1000), in controllers::ALL order.
        property <[{x: float, y: float}]> anchors: picture.anchors;
        property <int> lit: Math.max(remap-highlight, 0);
        property <RemapRow> selected-row: remap-rows[lit];
        property <length> row-x: selected-row.column == 0 ? margin : selected-row.column == 2 ? root.width - margin - column-w : (root.width - column-w) / 2;
        property <length> row-y: selected-row.column == 1 ? box-y + selected-row.row * row-pitch : list-y + selected-row.row * row-pitch;
        // Connector start: the row's edge facing the picture.
        property <length> line-x: selected-row.column == 0 ? row-x + column-w : selected-row.column == 2 ? row-x : row-x + column-w / 2;
        property <length> line-y: selected-row.column == 1 ? row-y : row-y + row-h / 2;
        property <length> end-x: picture-x + anchors[lit].x * ps;
        property <length> end-y: picture-y + anchors[lit].y * ps;

        background: @radial-gradient(circle, #1a2744 0%, #0d1320 45%, #080b12 100%);
        Hit { }

        Text {
            x: margin;
            y: 40 * u;
            text: "Controllers";
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        Text {
            x: margin;
            y: 96 * u;
            text: controllers-title;
            font-size: 22 * u;
            font-weight: 300;
            color: #ffffffb3;
        }

        // How the pad is read; click one, or hold LT / RT.
        HorizontalLayout {
            x: root.width - margin - self.width;
            y: 40 * u;
            width: 500 * u;
            height: 48 * u;
            spacing: 10 * u;
            for mode[i] in ["Test", "Focus", "Remap all"]: Rectangle {
                border-radius: 24 * u;
                background: i == controllers-mode ? #2d8cff : mode-hit.has-hover && Mouse.visible ? #ffffff2e : #ffffff12;
                border-width: 1px;
                border-color: i == controllers-mode ? transparent : #ffffff1f;
                HorizontalLayout {
                    padding-left: 24 * u;
                    padding-right: 24 * u;
                    Text {
                        text: mode;
                        font-size: 20 * u;
                        font-weight: i == controllers-mode ? 600 : 400;
                        color: white;
                        vertical-alignment: center;
                    }
                }

                mode-hit := Hit {
                    target: Target.controller-mode;
                    a: i;
                }
            }
        }

        Text {
            x: root.width - margin - self.width;
            y: 100 * u;
            text: "Hold LT / RT to switch";
            font-size: 18 * u;
            color: #ffffff66;
        }

        // Elbow line from the lit row to its button on the picture.
        if remap-highlight >= 0: Path {
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            stroke: #2d8cffc0;
            stroke-width: 2px;
            MoveTo {
                x: line-x / 1px;
                y: line-y / 1px;
            }

            LineTo {
                x: (selected-row.column == 1 ? line-x : (line-x + end-x) / 2) / 1px;
                y: (selected-row.column == 1 ? (line-y + end-y) / 2 : line-y) / 1px;
            }

            LineTo {
                x: end-x / 1px;
                y: end-y / 1px;
            }
        }

        picture := ControllerPicture {
            x: picture-x;
            y: picture-y;
            width: picture-w;
            height: picture-h;
            highlight: remap-highlight;
            live: live;
        }

        // Click a button on the picture to remap it.
        for anchor[i] in anchors: Hit {
            target: Target.remap-button;
            a: i;
            x: picture-x + anchor.x * ps - 34 * ps;
            y: picture-y + anchor.y * ps - 34 * ps;
            width: 68 * ps;
            height: 68 * ps;
        }

        if remap-highlight >= 0: Rectangle {
            x: end-x - 5px;
            y: end-y - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: #9fd0ff;
        }

        for row[i] in remap-rows: RemapRowView {
            Hit {
                target: Target.remap-row;
                a: i;
            }

            data: row;
            selected: i == remap-highlight;
            pressed: live[i];
            u: u;
            width: column-w;
            height: row-h;
            x: row.column == 0 ? margin : row.column == 2 ? root.width - margin - column-w : (root.width - column-w) / 2;
            y: row.column == 1 ? box-y + row.row * row-pitch : list-y + row.row * row-pitch;
        }

        HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 32 * u;
            if !run-active && controllers-mode == 0: Text {
                text: "Press any button to test it  ·  Click a button on the controller to remap it  ·  Click a row to add a key";
                color: #ffffff80;
                font-size: 19 * u;
                vertical-alignment: center;
            }

            if !run-active && controllers-mode == 1: ButtonHint {
                key: "A";
                label: "Remap";
                u: u;
            }

            if !run-active && controllers-mode == 1: Rectangle {
                border-radius: 10 * u;
                background: x-hit.has-hover && Mouse.visible ? #ffffff1a : transparent;
                HorizontalLayout {
                    padding-left: 6 * u;
                    padding-right: 6 * u;
                    spacing: 10 * u;
                    VerticalLayout {
                        alignment: center;
                        Badge {
                            label: "X";
                            u: u;
                        }
                    }

                    Text {
                        text: "Add a key";
                        color: #ffffffa6;
                        font-size: 20 * u;
                        vertical-alignment: center;
                    }
                }

                x-hit := Hit {
                    target: Target.remap-command;
                    a: 7;
                }
            }

            if !run-active && controllers-mode == 1: ButtonHint {
                key: "Y";
                label: "Clear added keys";
                u: u;
            }

            HorizontalLayout {
                spacing: 10 * u;
                HoldBadge {
                    progress: back-progress;
                    u: u;
                    Hit {
                        target: run-active ? Target.remap-command : Target.hold-exit;
                        a: 2;
                    }
                }

                Text {
                    text: run-active ? "Hold to stop" : "Hold to exit";
                    color: #ffffffa6;
                    font-size: 20 * u;
                    vertical-alignment: center;
                }
            }
        }

        // The remap in progress: what to press, and mouse buttons to go back, skip or stop. It sits
        // over the picture's empty lower half, between the columns, so no row it lights is hidden.
        if run-active: Rectangle {
            x: (parent.width - self.width) / 2;
            y: picture-y + picture-h - self.height + 10 * u;
            width: root.width - 2 * (margin + column-w + 24 * u);
            height: 200 * u;
            border-radius: 24 * u;
            background: #121a2bf7;
            border-width: 2px;
            border-color: run-kind == 2 ? #f5b942 : #2d8cff;
            drop-shadow-blur: 50 * u;
            drop-shadow-color: #2d8cff50;
            VerticalLayout {
                alignment: center;
                spacing: 12 * u;
                padding: 22 * u;
                Text {
                    text: run-title;
                    font-size: 25 * u;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: run-detail;
                    font-size: 18 * u;
                    color: #ffffff99;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 16 * u;
                    if run-kind == 1 && run-can-back: CommandButton {
                        label: "Back";
                        command: 0;
                        u: u;
                    }
                    if run-kind == 1: CommandButton {
                        label: "Skip";
                        command: 1;
                        u: u;
                    }
                    if run-kind == 2: CommandButton {
                        label: "Use it";
                        command: 3;
                        primary: true;
                        u: u;
                    }
                    if run-kind == 2: CommandButton {
                        label: "Press again";
                        command: 4;
                        u: u;
                    }
                    CommandButton {
                        label: run-kind == 0 ? "Cancel" : "Stop";
                        command: 2;
                        u: u;
                    }
                }
            }
        }

        // The hold in progress: what it will do and how far along it is.
        if hold-progress > 0: Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.height - 150 * u;
            width: 760 * u;
            height: 64 * u;
            border-radius: 18 * u;
            background: #121a2bf2;
            border-width: 1px;
            border-color: #2d8cff80;
            Text {
                y: 10 * u;
                width: parent.width;
                text: hold-text;
                font-size: 20 * u;
                color: white;
                horizontal-alignment: center;
            }

            Rectangle {
                x: 24 * u;
                y: parent.height - 18 * u;
                width: parent.width - 48 * u;
                height: 6 * u;
                border-radius: 3 * u;
                background: #ffffff1f;
                Rectangle {
                    x: 0;
                    width: parent.width * hold-progress;
                    border-radius: parent.border-radius;
                    background: #2d8cff;
                }
            }
        }

        if capturing: Rectangle {
            background: #000000b0;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 980 * u;
                height: 290 * u;
                border-radius: 24 * u;
                background: #121a2bfa;
                border-width: 2px;
                border-color: #2d8cff;
                drop-shadow-blur: 50 * u;
                drop-shadow-color: #2d8cff60;
                VerticalLayout {
                    alignment: center;
                    spacing: 14 * u;
                    padding: 30 * u;
                    Text {
                        text: capture-text;
                        font-size: 30 * u;
                        color: white;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Waiting a few seconds… press nothing to cancel";
                        font-size: 20 * u;
                        color: #ffffff80;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 16 * u;
                        if capture-can-clear: CommandButton {
                            label: "Remove added keys";
                            command: 6;
                            u: u;
                        }
                        CommandButton {
                            label: "Cancel";
                            command: 5;
                            u: u;
                        }
                    }
                }
            }
        }
    }

    // --- Add games screen ---
    if overlay == 5: Rectangle {
        property <length> row-h: 84 * u;
        property <length> row-pitch: 94 * u;
        property <length> list-y: 196 * u;
        property <int> visible-rows: 8;
        // Keeps the selected row in view, a little above the bottom edge.
        property <int> scroll: Math.max(0, Math.min(add-index - 5, add-rows.length - visible-rows));
        background: @radial-gradient(circle, #1a2744 0%, #0d1320 45%, #080b12 100%);
        Hit { }

        Text {
            x: margin;
            y: 40 * u;
            text: add-title;
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        Text {
            x: margin;
            y: 96 * u;
            width: root.width - 2 * margin;
            text: add-status;
            font-size: 22 * u;
            font-weight: 300;
            color: #ffffffb3;
            overflow: elide;
        }

        // Where the results come from, and how to change it.
        if add-mode == 0: HorizontalLayout {
            x: margin;
            y: 134 * u;
            height: 36 * u;
            spacing: 10 * u;
            alignment: start;
            Text {
                text: "\u{E8B7}";
                font-family: "Segoe MDL2 Assets";
                font-size: 18 * u;
                color: #8cc4ff;
                vertical-alignment: center;
            }

            Text {
                text: add-place;
                font-size: 19 * u;
                color: #8cc4ff;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: "·  LB to change";
                font-size: 19 * u;
                color: #ffffff73;
                vertical-alignment: center;
            }
        }

        for row[i] in add-rows: AddRowView {
            Hit {
                target: Target.add-row;
                a: i;
            }

            data: row;
            selected: i == add-index;
            u: u;
            x: margin;
            y: list-y + (i - scroll) * row-pitch;
            width: root.width - 2 * margin;
            height: row-h;
            visible: i >= scroll && i < scroll + visible-rows;
            animate y { duration: 150ms; easing: ease-out; }
        }

        if add-rows.length == 0: VerticalLayout {
            x: margin;
            y: 320 * u;
            width: root.width - 2 * margin;
            spacing: 18 * u;
            Text {
                text: add-mode != 0 ? "\u{E8B7}" : add-scanning ? "\u{E721}" : "\u{E7FC}";
                font-family: "Segoe MDL2 Assets";
                font-size: 64 * u;
                color: #ffffff59;
                horizontal-alignment: center;
            }

            Text {
                text: add-mode != 0 ? "This folder has no subfolders" : add-scanning ? "Looking through " + add-place.to-lowercase() : "Nothing new to add here";
                font-size: 30 * u;
                font-weight: 300;
                color: #ffffffcc;
                horizontal-alignment: center;
            }

            Text {
                text: add-mode != 0 ? "Press Y to look in it anyway, or B to go up" : add-scanning ? "External drives count too, as long as they are plugged in" : "Press LB to look somewhere else, or RB to look again";
                font-size: 20 * u;
                color: #ffffff73;
                horizontal-alignment: center;
            }
        }

        if add-mode == 0: HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 30 * u;
            ButtonHint {
                key: "A";
                label: "Add";
                u: u;
            }

            ButtonHint {
                key: "← →";
                label: "Other exe";
                u: u;
            }

            ButtonHint {
                key: "Y";
                label: "Ignore / restore";
                u: u;
            }

            ButtonHint {
                key: "LB";
                label: "Where to look";
                u: u;
            }

            ButtonHint {
                key: "RB";
                label: "Look again";
                u: u;
            }

            ButtonHint {
                key: "B";
                label: "Back";
                u: u;
            }
        }

        if add-mode == 1: HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 30 * u;
            ButtonHint {
                key: "A";
                label: "Choose";
                u: u;
            }

            ButtonHint {
                key: "B";
                label: "Back";
                u: u;
            }
        }

        if add-mode == 2: HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 30 * u;
            ButtonHint {
                key: "A";
                label: "Open";
                u: u;
            }

            ButtonHint {
                key: "Y";
                label: "Look in this folder";
                u: u;
            }

            ButtonHint {
                key: "B";
                label: "Up";
                u: u;
            }
        }
    }

    // --- Choose art screen ---
    if overlay == 6: Rectangle {
        // Per row: top, thumbnail size (covers portrait, backgrounds wide, logos on a plate).
        property <[{y: length, w: length, h: length}]> rows: [
            { y: 200 * u, w: 150 * u, h: 225 * u },
            { y: 506 * u, w: 340 * u, h: 191 * u },
            { y: 790 * u, w: 320 * u, h: 140 * u },
        ];
        property <length> gap: 22 * u;
        background: @radial-gradient(circle, #1a2744 0%, #0d1320 45%, #080b12 100%);
        Hit { }

        Text {
            x: margin;
            y: 40 * u;
            text: "Choose art";
            font-size: 40 * u;
            font-weight: 600;
            color: white;
        }

        Text {
            x: margin + 230 * u;
            y: 52 * u;
            width: root.width - self.x - margin;
            text: art-title;
            font-size: 28 * u;
            font-weight: 300;
            color: #ffffffcc;
            overflow: elide;
        }

        Text {
            x: margin;
            y: 96 * u;
            width: root.width - 2 * margin;
            text: art-status;
            font-size: 20 * u;
            font-weight: 300;
            color: #ffffff99;
            overflow: elide;
        }

        for row[r] in art-rows: Rectangle {
            property <bool> active: r == art-slot;
            property <length> pitch: rows[r].w + gap;
            // Keeps the selected picture in view with a few before it.
            property <int> scroll: Math.max(0, row.focus - Math.floor((root.width - 2 * margin) / pitch / 2));
            x: 0;
            y: rows[r].y - 46 * u;
            width: root.width;
            height: rows[r].h + 46 * u;

            HorizontalLayout {
                x: margin;
                y: 0;
                height: 34 * u;
                spacing: 14 * u;
                alignment: start;
                Text {
                    text: row.name;
                    font-size: 24 * u;
                    font-weight: active ? 700 : 400;
                    color: active ? white : #ffffff8c;
                    vertical-alignment: center;
                }

                Text {
                    text: row.label;
                    font-size: 18 * u;
                    color: active ? #8cc4ff : #ffffff59;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            for thumb[i] in row.thumbs: ArtThumbView {
                Hit {
                    target: Target.art-thumb;
                    a: r;
                    b: i;
                }

                data: thumb;
                selected: i == row.focus;
                row-active: active;
                plate: r == 2;
                u: u;
                x: margin + (i - scroll) * pitch;
                y: 46 * u;
                width: rows[r].w;
                height: rows[r].h;
                visible: self.x > -self.width && self.x < root.width;
                opacity: active || i == row.focus ? 1 : 0.6;
                animate x { duration: 150ms; easing: ease-out; }
            }
        }

        HorizontalLayout {
            x: margin;
            y: root.height - 66 * u;
            width: root.width - 2 * margin;
            height: 46 * u;
            alignment: end;
            spacing: 30 * u;
            ButtonHint {
                key: "← →";
                label: "Choose";
                u: u;
            }

            ButtonHint {
                key: "↑ ↓";
                label: "Cover / Background / Logo";
                u: u;
            }

            ButtonHint {
                key: "A";
                label: "Use this";
                u: u;
            }

            ButtonHint {
                key: "B";
                label: "Done";
                u: u;
            }
        }
    }

    // Messages sit in the empty band between the game row and the title, clear of every row.
    Rectangle {
        // Beside the quick panel while it is open, so messages never cover its tiles.
        x: (overlay == 1 || overlay == 2 ? root.width - 620 * u : root.width) - margin - self.width;
        // The Controllers screen fills the band below the header, so messages use the header's corner there.
        y: overlay >= 4 ? 44 * u : 320 * u;
        width: min(toast-text.preferred-width + 60 * u, root.width - 2 * margin);
        height: 60 * u;
        border-radius: self.height / 2;
        background: #141a26f2;
        border-width: 1px;
        border-color: #ffffff26;
        opacity: toast-visible ? 1 : 0;
        animate opacity { duration: 200ms; }
        toast-text := Text {
            x: 30 * u;
            width: parent.width - 60 * u;
            height: parent.height;
            text: toast;
            color: white;
            font-size: 22 * u;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    keys := FocusScope {
        key-released(event) => {
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.back-released();
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.action(Action.up);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.action(Action.down);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.action(Action.left);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.action(Action.right);
                return accept;
            }
            if (event.text == Key.Return) {
                root.action(Action.confirm);
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.action(Action.back);
                return accept;
            }
            if (event.text == Key.Space) {
                root.action(Action.options);
                return accept;
            }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.action(Action.tab-prev);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.action(Action.tab-next);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.action(Action.page-prev);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.action(Action.page-next);
                return accept;
            }
            if (event.text == Key.F1) {
                root.action(Action.menu);
                return accept;
            }
            return reject;
        }
    }


    init => {
        keys.focus();
    }
}
